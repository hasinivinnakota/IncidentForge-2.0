# ==============================================================================
# IncidentForge — Wazuh Stack Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env before starting the stack:
# cp .env.example .env

WAZUH_VERSION=4.9.0

# Wazuh Indexer Security
INDEXER_USERNAME=admin
INDEXER_PASSWORD=<set-a-strong-indexer-password>

# Wazuh Manager API Security
API_USERNAME=wazuh-wui
API_PASSWORD=<set-a-strong-manager-api-password>

# Wazuh Dashboard Security
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<set-the-indexer-password>
