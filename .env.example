# ============================================
# IncidentForge — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================

# ------------------------------------------
# Wazuh Configuration
# ------------------------------------------
WAZUH_MANAGER_HOST=127.0.0.1
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME
WAZUH_INDEXER_HOST=127.0.0.1
WAZUH_INDEXER_PORT=9200
WAZUH_DASHBOARD_PORT=443

# ------------------------------------------
# Backend Configuration
# ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_DEBUG=false
BACKEND_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY
BACKEND_CORS_ORIGINS=http://localhost:5173

# ------------------------------------------
# Database (if needed in later phases)
# ------------------------------------------
# DATABASE_URL=sqlite:///./incidentforge.db

# ------------------------------------------
# AI / LLM Configuration
# ------------------------------------------
# Choose one provider:
AI_PROVIDER=openai
# AI_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o

# Google Gemini
# GEMINI_API_KEY=CHANGE_ME
# GEMINI_MODEL=gemini-pro

# ------------------------------------------
# Threat Intelligence
# ------------------------------------------
# AbuseIPDB (optional)
# ABUSEIPDB_API_KEY=CHANGE_ME

# VirusTotal (optional)
# VIRUSTOTAL_API_KEY=CHANGE_ME

# AlienVault OTX (optional)
# OTX_API_KEY=CHANGE_ME

# ------------------------------------------
# Dashboard Configuration
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WAZUH_DASHBOARD_URL=https://localhost:443

# ------------------------------------------
# Docker Resource Limits
# ------------------------------------------
WAZUH_MANAGER_MEMORY_LIMIT=1g
WAZUH_INDEXER_MEMORY_LIMIT=1536m
WAZUH_DASHBOARD_MEMORY_LIMIT=512m
INDEXER_JAVA_OPTS=-Xms512m -Xmx1536m

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/incidentforge.log
